{
  "manifest_version": 3,
  "name": "Canvas Resource Auditor",
  "version": "1.0",
  "description": "Detecta recursos rotos (imágenes, videos, links, APIs) en Canvas LMS y genera reportes para email",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ver errores detectados"
  }
}